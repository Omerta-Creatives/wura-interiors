# Neon Postgres connection string (Neon Console → Connection Details → Pooled connection string)
DATABASE_URL=postgresql://neondb_owner:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Better Auth secret (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-secret-string
BETTER_AUTH_URL=http://localhost:3000

# Paystack credentials (Paystack Dashboard → Settings → API Keys & Webhooks)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Production site URL (used for sitemap, canonical URLs, Open Graph, and Paystack callback redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
